# ══════════════════════════════════════════════════════════════════
# GEO OS v1 — Variables de Entorno (.env.example)
#
# ⚠️  NUNCA commitear el .env real. Solo este archivo (.env.example).
# Copiar como .env en el VPS y completar con valores rotados.
#
# Rotación: ver ROTATE_SECRETS.md para URLs de cada dashboard.
# ══════════════════════════════════════════════════════════════════

# ── Telegram ─────────────────────────────────────────────────────
# Obtener de @BotFather → /token
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_ALLOWED_USER_IDS=<your_telegram_user_id>
ADMIN_TELEGRAM_ID=<your_telegram_user_id>

# ── LLM — Motor principal ─────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your_gemini_api_key>

# Anthropic (fallback): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<your_anthropic_api_key_or_leave_empty>
CLAUDE_MODEL=claude-sonnet-4-6

# Groq (fallback rápido): https://console.groq.com/keys
GROQ_API_KEY=<your_groq_api_key>

# OpenRouter (fallback multi-modelo): https://openrouter.ai/keys
OPENROUTER_API_KEY=<your_openrouter_api_key_or_leave_empty>
OPENROUTER_MODEL=openrouter/free

# DeepSeek (razonamiento): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=<your_deepseek_api_key>
DEEPSEEK_MODEL=deepseek-chat

# Together AI (opcional): https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=<your_together_api_key_or_leave_empty>

# Fireworks AI (opcional): https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=<your_fireworks_api_key_or_leave_empty>

CLAUDE_PAID=false

# ── TTS — Voz ────────────────────────────────────────────────────
# Proveedores: elevenlabs | google | none
TTS_PROVIDER=elevenlabs
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=<your_elevenlabs_api_key>

# ── Firebase ─────────────────────────────────────────────────────
# Opción A: ruta al archivo local (no commitear el archivo)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Opción B: JSON completo como string (para VPS sin archivos sueltos)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Shopify Admin API ─────────────────────────────────────────────
# Dashboard: https://admin.shopify.com → Settings → Apps → Private apps
SHOPIFY_STORE_DOMAIN=ecoorigenchile.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=<your_shopify_admin_token>
USD_TO_CLP=950

# ── Stripe (pagos) ───────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=<sk_live_your_stripe_secret_key>
STRIPE_PUBLISHABLE_KEY=<pk_live_your_stripe_publishable_key>
STRIPE_WEBHOOK_SECRET=<whsec_your_webhook_secret>

# ── Base de datos ────────────────────────────────────────────────
DB_PATH=./memory.db

# ── API / Seguridad ──────────────────────────────────────────────
# Generar: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=<generate_64_random_bytes_hex>
PORT=3000

# ── Servidor / Infraestructura ───────────────────────────────────
# URL pública del backend (la que usa la app móvil)
PUBLIC_API_URL=https://api.geoos.app

# ── n8n (automatización) ─────────────────────────────────────────
N8N_BASE_URL=https://marioovalle.app.n8n.cloud

# ── Control de Tokens ────────────────────────────────────────────
TOKEN_DAILY_LIMIT=100000
TOKEN_MONTHLY_LIMIT=2000000

# ── Agente ───────────────────────────────────────────────────────
MAX_ITERATIONS=10
